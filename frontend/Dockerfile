FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

# Build args
ARG STRIPE_PRICE_STARTER_MONTHLY
ARG STRIPE_PRICE_TEAM_MONTHLY
ARG STRIPE_PRICE_BUSINESS_MONTHLY
ARG STRIPE_PRICE_EXTRA_REPO_MONTHLY
ARG STRIPE_PRICE_STARTER_YEARLY
ARG STRIPE_PRICE_TEAM_YEARLY
ARG STRIPE_PRICE_BUSINESS_YEARLY
ARG NEXT_PUBLIC_GOOGLE_ANALYTICS
ARG NEXT_PUBLIC_RECAPTCHA_SITE_KEY

# Set env vars for build
ENV STRIPE_PRICE_STARTER_MONTHLY=$STRIPE_PRICE_STARTER_MONTHLY
ENV STRIPE_PRICE_TEAM_MONTHLY=$STRIPE_PRICE_TEAM_MONTHLY
ENV STRIPE_PRICE_BUSINESS_MONTHLY=$STRIPE_PRICE_BUSINESS_MONTHLY
ENV STRIPE_PRICE_EXTRA_REPO_MONTHLY=$STRIPE_PRICE_EXTRA_REPO_MONTHLY
ENV STRIPE_PRICE_STARTER_YEARLY=$STRIPE_PRICE_STARTER_YEARLY
ENV STRIPE_PRICE_TEAM_YEARLY=$STRIPE_PRICE_TEAM_YEARLY
ENV STRIPE_PRICE_BUSINESS_YEARLY=$STRIPE_PRICE_BUSINESS_YEARLY
ENV NEXT_PUBLIC_GOOGLE_ANALYTICS=$NEXT_PUBLIC_GOOGLE_ANALYTICS
ENV NEXT_PUBLIC_RECAPTCHA_SITE_KEY=$NEXT_PUBLIC_RECAPTCHA_SITE_KEY

# Build Next.js app
RUN npm run build

EXPOSE 3000

CMD ["npm", "start"]
