# Hakam Service URLs
AUTH_SERVICE_URL=http://auth-service:8000
API_SERVICE_URL=http://api-service:8000
MCP_SERVICE_URL=http://mcp-service:8000
FRONTEND_URL=http://localhost:3000

# Database Configuration
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=hakam_db
MYSQL_USER=hakam_user
MYSQL_PASSWORD=hakam_password

# JWT Configuration
# Use a strong secret for production
JWT_SECRET=supersecretkeyForPhase2DevelopmentOnly
JWT_ALGORITHM=HS256

# Encryption
# 32-byte base64 encoded key (e.g., generated via `openssl rand -base64 32`)
TOKEN_ENCRYPTION_KEY=change_this_to_a_valid_32_byte_base64_key==

# Internal Secrets
INTERNAL_WORKER_SECRET=internal_secret_for_agent_worker

# MCP Configuration
GITHUB_TOKEN= # Optional: For local testing if needed

API_BASE_URL=https://your-domain.com
WEBHOOK_SECRET=supersecret

#Stripe config
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
#FRONTEND_BASE_URL=http://localhost:3000

STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_EXTRA_REPO_MONTHLY=

STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_TEAM_YEARLY=
STRIPE_PRICE_BUSINESS_YEARLY=

