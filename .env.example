# ==============================================================================
# Hakam Open-Source Environment Configuration (.env.example)
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE NETWORKING & SERVICE URLS
# ------------------------------------------------------------------------------
AUTH_SERVICE_URL=http://auth-service:8000
API_SERVICE_URL=http://api-service:8000
MCP_SERVICE_URL=http://mcp-service:8000
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8002
FRONTEND_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MySQL 8.0)
# ------------------------------------------------------------------------------
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=hakam_db
MYSQL_USER=hakam_user
MYSQL_PASSWORD=hakam_password

# ------------------------------------------------------------------------------
# 3. SECURITY & CRYPTOGRAPHY (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# Generate a secure JWT secret: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production
JWT_ALGORITHM=HS256

# 32-byte Base64-encoded key for AES encryption of provider access tokens
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=MTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTI=

# Shared secret between api-service and background agent-service worker
INTERNAL_WORKER_SECRET=replace_with_internal_secret_for_agent_worker

# Webhook signature secret for incoming repository provider hooks
WEBHOOK_SECRET=replace_with_secure_webhook_secret

# ------------------------------------------------------------------------------
# 4. COMMUNITY VS SAAS MONETIZATION
# ------------------------------------------------------------------------------
# Set to false for self-hosted/community edition (unlimited repositories, no Stripe needed).
# Set to true only if you run a commercial SaaS instance with Stripe billing.
BILLING_ENABLED=false
NEXT_PUBLIC_BILLING_ENABLED=false

# ------------------------------------------------------------------------------
# 5. CODE HOSTING PROVIDERS (OPTIONAL - ENABLE AS NEEDED)
# ------------------------------------------------------------------------------

# GitHub App Integration
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
NEXT_PUBLIC_GITHUB_APP_URL=

# GitLab OAuth & Integration
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=http://localhost:3000/dashboard/integrations/gitlab-callback

# ------------------------------------------------------------------------------
# 6. AI / LLM CONFIGURATION (OPTIONAL - FOR SEMANTIC REVIEWS)
# ------------------------------------------------------------------------------
# Supported providers: openai, gemini
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# 7. EMAIL & VERIFICATION (UNIVERSAL SMTP - OPTIONAL)
# ------------------------------------------------------------------------------
# Set to false for self-hosted/trusted environments:
# - Users are automatically verified upon signup (no email confirmation needed).
# - You do not need to configure an SMTP server or email provider.
# Set to true if you run a public instance and wish to verify user emails via SMTP.
EMAIL_VERIFICATION_REQUIRED=false

# SMTP Server Settings (Optional - leave empty if EMAIL_VERIFICATION_REQUIRED=false)
# Supports AWS SES, SendGrid, Mailgun, Postmark, Gmail, or local Postfix
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com

# Legacy ZeptoMail variables (fallback compatibility)
ZEPTOMAIL_SMTP_HOST=
ZEPTOMAIL_SMTP_PORT=
ZEPTOMAIL_USERNAME=
ZEPTOMAIL_PASSWORD=
ZEPTOMAIL_FROM_EMAIL=

# ------------------------------------------------------------------------------
# 8. OPTIONAL SECURITY & ANALYTICS
# ------------------------------------------------------------------------------
# Google reCAPTCHA (set to false for local/self-hosted development to disable verification)
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Google Analytics (leave empty to disable analytics tracking)
NEXT_PUBLIC_GOOGLE_ANALYTICS=

# ------------------------------------------------------------------------------
# 9. COMMERCIAL STRIPE BILLING (ONLY WHEN BILLING_ENABLED=true)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_EXTRA_REPO_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_TEAM_YEARLY=
STRIPE_PRICE_BUSINESS_YEARLY=
