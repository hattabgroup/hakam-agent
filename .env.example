# Hakam Service URLs
AUTH_SERVICE_URL=http://auth-service:8000
API_SERVICE_URL=http://api-service:8000
MCP_SERVICE_URL=http://mcp-service:8000
FRONTEND_URL=http://localhost:3000

# Database Configuration
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=hakam_db
MYSQL_USER=hakam_user
MYSQL_PASSWORD=hakam_password

# JWT Configuration
# Use a strong secret for production
JWT_SECRET=supersecretkeyForPhase2DevelopmentOnly
JWT_ALGORITHM=HS256

# Encryption
# 32-byte base64 encoded key (e.g., generated via `openssl rand -base64 32`)
TOKEN_ENCRYPTION_KEY=change_this_to_a_valid_32_byte_base64_key==

# Internal Secrets
INTERNAL_WORKER_SECRET=internal_secret_for_agent_worker

# GitHub App Configuration
# GITHUB_TOKEN= # Legacy PAT
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
NEXT_PUBLIC_GITHUB_APP_URL=

# GitLab OAuth Configuration
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=http://localhost:3000/dashboard/integrations/gitlab-callback

API_BASE_URL=https://your-domain.com
WEBHOOK_SECRET=supersecret

#Stripe config
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
#FRONTEND_BASE_URL=http://localhost:3000

STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_EXTRA_REPO_MONTHLY=

STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_TEAM_YEARLY=
STRIPE_PRICE_BUSINESS_YEARLY=

#Stripe webhook
#Select events: Add checkout.session.completed and customer.subscription.*.
#Example: https://<random-id>.ngrok-free.app/billing/webhook


# GA token
NEXT_PUBLIC_GOOGLE_ANALYTICS=

# ZeptoMail Configuration
ZEPTOMAIL_SMTP_HOST=smtp.zeptomail.com
ZEPTOMAIL_SMTP_PORT=587
ZEPTOMAIL_USERNAME=emailapikey
ZEPTOMAIL_PASSWORD=
ZEPTOMAIL_FROM_EMAIL=

# Google reCAPTCHA v2
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
